{
    "manifest_version": 3,
    "name": "TVP",
    "version": "1.0.0",
    "description": "TVING & WAVVE Watch Party",

    "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
},

"action": {
    "default_icon": {
        "16": "icon.png",
        "32": "icon.png"
    },
    "default_popup": "popup.html",
    "default_title": "TVP"
},

    "permissions": [
        "storage",
        "activeTab"
    ],

    "host_permissions": [
    "https://www.tving.com/*",
    "https://www.wavve.com/*",
    "https://www.disneyplus.com/*",
    "http://localhost:3000/*",
    "https://try-server-5rp4.onrender.com/*",
    "https://test-server-wp3c.onrender.com/*"
],

    "content_scripts": [
    {
        "matches": [
            "https://www.tving.com/*"
        ],
        "js": [
            "content-tving.js"
        ],
        "run_at": "document_idle"
    },
    {
        "matches": [
            "https://www.wavve.com/*"
        ],
        "js": [
            "content-wavve.js"
        ],
        "run_at": "document_idle"
    },

    {
    "matches": [
        "https://www.disneyplus.com/*"
    ],
    "js": [
        "disney-main.js"
    ],
    "run_at": "document_start",
    "world": "MAIN"
},

    {
        "matches": [
            "https://www.disneyplus.com/*"
        ],
        "js": [
            "content-disney.js"
        ],
        "run_at": "document_idle"
    }
],

    "web_accessible_resources": [
        {
            "resources": [
                "panel.html",
                "panel.css",
                "panel.js",
                "socket.io.min.js"
            ],
            "matches": [
                "https://www.tving.com/*",
                "https://www.wavve.com/*",
                "https://www.disneyplus.com/*"
            ]
        }
    ]
}